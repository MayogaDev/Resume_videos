@startuml Flujo_Inferencia_Video
!theme vibrant
skinparam backgroundColor #FAFBFC
skinparam roundcorner 10
skinparam shadowing true
skinparam defaultFontSize 11

title **Flujo de Inferencia - Resumir Video Educativo**\n**Uso del Modelo Entrenado (5-10 minutos por video)**

start

:👤 **Usuario sube video educativo**;
note right
    • Formato: MP4, AVI, MKV
    • Duración: 10 min - 2 horas
    • Idioma: Español/Inglés
    • Tamaño: < 2GB
end note

partition "📹 **PROCESAMIENTO DE VIDEO**" {
    :Validar formato de video;
    
    if (¿Formato válido?) then (no)
        :❌ Error: Formato no soportado;
        stop
    else (sí)
        :✅ Video aceptado;
    endif
    
    :Extraer metadata;
    note right
        • Duración
        • Resolución
        • Codec de audio
        • Sample rate
    end note
    
    :🎵 Extraer audio del video;
    note right
        **Librería: MoviePy**
        • Convierte a WAV/MP3
        • Sample rate: 16kHz
        • Mono channel
        • Duración: ~30 segundos
    end note
}

partition "🎤 **TRANSCRIPCIÓN CON WHISPER**" {
    :Cargar modelo Whisper;
    note right
        **Modelo Pre-entrenado**
        • Tamaño: base/small
        • Multilingüe
        • No requiere GPU
        • Cargado en RAM
    end note
    
    :Detectar idioma automáticamente;
    note right
        • Español: 'es'
        • Inglés: 'en'
        • Confianza: 0.95+
    end note
    
    repeat
        :Procesar chunk de audio (30s);
        :Transcribir a texto;
        :Agregar timestamps;
    repeat while (¿Más audio?) is (sí)
    
    :Unir todas las transcripciones;
    
    :💾 Guardar transcripción completa;
    note right
        **Formato JSON:**
        {
          "text": "...",
          "segments": [...],
          "language": "es",
          "duration": 1800
        }
    end note
    
    :Mostrar transcripción al usuario;
}

partition "📝 **PREPROCESAMIENTO**" {
    :Leer transcripción;
    
    :Limpiar texto;
    note right
        • Remover caracteres especiales
        • Normalizar espacios
        • Corregir puntuación
    end note
    
    if (¿Texto muy largo?) then (sí, >512 tokens)
        :Dividir en chunks;
        note right
            • Max: 512 tokens por chunk
            • Overlap: 50 tokens
            • Mantener contexto
        end note
    else (no)
        :Mantener texto completo;
    endif
    
    :Agregar prefijo "resumir:";
    note right
        • Input: "resumir: [TEXTO]"
        • Formato esperado por mT5
    end note
}

partition "🔤 **TOKENIZACIÓN**" {
    :Cargar tokenizer mT5;
    note right
        • Cargado desde ./models/
        • Mismo tokenizer del entrenamiento
    end note
    
    repeat
        :Tokenizar chunk;
        note right
            • Texto → IDs numéricos
            • Max length: 512
            • Padding si necesario
        end note
        
        :Crear attention mask;
    repeat while (¿Más chunks?) is (sí)
}

partition "🧠 **GENERACIÓN DE RESUMEN**" {
    :Cargar modelo mT5 fine-tuned;
    note right
        **Modelo Entrenado**
        • Path: ./models/mt5-small-mlsum-es/
        • Pesos: pytorch_model.bin (1.2GB)
        • Carga en GPU (si disponible)
        • Modo: eval()
    end note
    
    repeat
        :Enviar chunk tokenizado al modelo;
        
        :Generar resumen con beam search;
        note right
            **Parámetros de generación:**
            • num_beams: 4
            • max_length: 128 tokens
            • length_penalty: 2.0
            • early_stopping: True
            • no_repeat_ngram_size: 3
        end note
        
        :Decodificar IDs → texto;
        note right
            • IDs numéricos → palabras
            • Remover tokens especiales
            • Limpiar formato
        end note
        
    repeat while (¿Más chunks?) is (sí)
    
    if (¿Múltiples resúmenes?) then (sí)
        :Unir resúmenes coherentemente;
        note right
            • Eliminar redundancias
            • Mantener coherencia
            • Orden lógico
        end note
    endif
}

partition "✨ **POST-PROCESAMIENTO**" {
    :Limpiar resumen final;
    note right
        • Capitalizar primera letra
        • Corregir puntuación
        • Formato legible
    end note
    
    :Calcular estadísticas;
    note right
        • Longitud original: 5000 palabras
        • Longitud resumen: 150 palabras
        • Ratio compresión: 97%
        • Tiempo procesamiento: 7 min
    end note
    
    :Calcular métricas de calidad;
    note right
        • Coherencia textual
        • Cobertura de temas
        • Densidad de información
    end note
}

partition "💾 **ALMACENAMIENTO**" {
    :Guardar en base de datos;
    note right
        **Registro:**
        • ID video
        • Transcripción completa
        • Resumen generado
        • Métricas
        • Timestamp
        • Usuario
    end note
    
    :Generar archivos de salida;
    note right
        • resumen.txt
        • resumen.pdf
        • resumen.json
        • metadata.json
    end note
}

partition "🌐 **PRESENTACIÓN**" {
    :Generar página HTML;
    note right
        **Componentes:**
        • Video original embebido
        • Transcripción completa
        • Resumen generado
        • Estadísticas visuales
        • Botón de descarga
    end note
    
    :Mostrar comparación lado a lado;
    note left
        | Original | Resumen |
        | 5000 palabras | 150 palabras |
        | 30 minutos lectura | 1 minuto lectura |
    end note
    
    :Permitir edición del resumen;
    note right
        • Usuario puede ajustar
        • Agregar/quitar contenido
        • Exportar versión final
    end note
}

:👤 **Usuario visualiza resumen**;

if (¿Usuario satisfecho?) then (no)
    :Regenerar con parámetros ajustados;
    note right
        • Cambiar longitud
        • Ajustar nivel de detalle
        • Enfocar en temas específicos
    end note
else (sí)
    :✅ Proceso completado;
endif

stop

legend bottom
    **Tiempos por Fase (video 30 min):**
    • Extracción audio: 30 seg
    • Transcripción Whisper: 2-3 min
    • Preprocesamiento: 10 seg
    • Generación resumen: 1-2 min
    • Post-procesamiento: 20 seg
    • **Total: 5-7 minutos**
    
    **Recursos Usados:**
    • GPU: 2GB VRAM (inferencia)
    • RAM: 4GB
    • CPU: Whisper transcription
end legend

note bottom
    **Diferencia con Entrenamiento:**
    • Entrenamiento: 1 vez, 4-6 horas
    • Inferencia: cada video, 5-10 min
    • Entrenamiento: usa dataset
    • Inferencia: usa modelo entrenado
end note

@enduml

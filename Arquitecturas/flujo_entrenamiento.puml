@startuml Flujo_Entrenamiento_Detallado
!theme blueprint
skinparam backgroundColor #F0F4F8
skinparam roundcorner 10
skinparam shadowing true
skinparam defaultFontSize 11

title **Flujo de Entrenamiento Detallado - Fine-tuning mT5**\n**Transfer Learning + Fine-tuning en Dataset MLSUM (Español)**

start

:👤 **Usuario inicia entrenamiento**;

partition "🔧 **PREPARACIÓN**" {
    :Verificar GPU disponible;
    note right
        • RTX 3050: 4GB VRAM
        • CUDA 12.8
        • PyTorch 2.7.1
    end note
    
    :Crear directorios de salida;
    note right
        • ./models/
        • ./logs/
        • ./data/cache/
    end note
    
    :Configurar logging;
}

partition "📥 **CARGA DE DATOS**" {
    :📊 Descargar Dataset MLSUM;
    note right
        **Dataset Público**
        • Fuente: Hugging Face
        • Tamaño: 266K artículos
        • Idioma: Español
        • Tamaño descarga: ~1.5GB
    end note
    
    :Seleccionar subset;
    note right
        • Train: 10,000 ejemplos
        • Validation: 1,000 ejemplos
        • Test: 500 ejemplos
    end note
    
    :Mostrar ejemplo del dataset;
    note right
        Ejemplo:
        • Input: "El presidente anunció..."
        • Target: "Anuncio presidencial sobre..."
    end note
}

partition "🔤 **TOKENIZACIÓN**" {
    :Cargar tokenizer mT5;
    note right
        • Modelo: google/mt5-small
        • Vocabulario: 250K tokens
        • SentencePiece tokenizer
    end note
    
    :Agregar prefijo "resumir:";
    
    :Tokenizar textos de entrada;
    note right
        • Max length: 512 tokens
        • Truncation: True
        • Padding: Dynamic (en collator)
    end note
    
    :Tokenizar resúmenes (labels);
    note right
        • Max length: 128 tokens
        • Special token: -100 para padding
    end note
    
    :Guardar dataset tokenizado;
}

partition "🧠 **CARGA DE MODELO**" {
    :Descargar mT5-small pre-entrenado;
    note right
        **Transfer Learning**
        • Parámetros: 300M
        • Pre-entrenado en 101 idiomas
        • Tamaño: ~1.2GB
        • Ya sabe gramática y sintaxis
    end note
    
    :Habilitar gradient checkpointing;
    note right
        • Ahorra memoria VRAM
        • Permite batch size más grande
        • Trade-off: +10% tiempo
    end note
}

partition "⚙️ **CONFIGURACIÓN**" {
    :Configurar Training Arguments;
    note right
        **Hiperparámetros RTX 3050**
        • Batch size: 2
        • Gradient accumulation: 8
        • → Batch efectivo: 16
        • Learning rate: 3e-5
        • FP16: True (precisión mixta)
        • Épocas: 3
        • Warmup steps: 500
    end note
    
    :Configurar métricas ROUGE;
    note right
        • ROUGE-1: palabras comunes
        • ROUGE-2: bigramas
        • ROUGE-L: subsecuencia más larga
    end note
    
    :Configurar callbacks;
    note right
        • Early Stopping (patience: 3)
        • Checkpoints (cada 500 steps)
        • TensorBoard logging
    end note
}

partition "🏋️ **ENTRENAMIENTO**" {
    :Iniciar Seq2SeqTrainer;
    
    repeat
        :📈 **Iteración de Entrenamiento**;
        
        :Cargar batch (2 ejemplos);
        
        :Forward pass en GPU;
        note right
            • Modelo genera predicciones
            • Calcula loss (CrossEntropy)
        end note
        
        :Backward pass;
        note right
            • Calcula gradientes
            • FP16 (mixed precision)
        end note
        
        :Acumular gradientes (8 steps);
        
        :Actualizar pesos del modelo;
        note right
            • Optimizer: AdamW
            • Gradient clipping: 1.0
            • Learning rate scheduler
        end note
        
        :Limpiar memoria GPU;
        
        if (Step múltiplo de 50?) then (sí)
            :📊 Logging de métricas;
            note right
                • Loss actual
                • Learning rate
                • GPU memory usage
            end note
        endif
        
        if (Step múltiplo de 500?) then (sí)
            :💾 Guardar checkpoint;
            note right
                • pytorch_model.bin
                • optimizer.pt
                • scheduler.pt
                • training_args.bin
            end note
            
            :📊 Evaluación en validation set;
            
            repeat
                :Cargar batch de validación;
                :Generar resumen con beam search;
                :Calcular ROUGE scores;
            repeat while (¿Más batches?) is (sí)
            
            :Mostrar métricas de validación;
            note right
                • ROUGE-1: 0.35 → 0.42
                • ROUGE-2: 0.15 → 0.18
                • ROUGE-L: 0.28 → 0.35
            end note
            
            if (¿Mejor modelo?) then (sí)
                :💾 Guardar como best_model;
            endif
            
            if (¿No mejora en 3 evaluaciones?) then (sí)
                :⚠️ Early Stopping activado;
                stop
            endif
        endif
        
    repeat while (¿Completó 3 épocas?) is (no)
    
    :✅ Entrenamiento completado;
}

partition "📊 **EVALUACIÓN FINAL**" {
    :Cargar mejor modelo guardado;
    
    :Evaluar en test set (500 ejemplos);
    
    repeat
        :Cargar ejemplo de test;
        :Generar resumen;
        :Comparar con resumen real;
        :Calcular ROUGE;
    repeat while (¿Más ejemplos?) is (sí)
    
    :Calcular métricas finales;
    note right
        **Resultados Esperados**
        • ROUGE-1: 0.40 - 0.45
        • ROUGE-2: 0.18 - 0.22
        • ROUGE-L: 0.32 - 0.38
    end note
}

partition "💾 **GUARDAR MODELO**" {
    :Guardar modelo final;
    note right
        **Archivos generados:**
        • pytorch_model.bin (1.2GB)
        • config.json
        • tokenizer_config.json
        • special_tokens_map.json
        • spiece.model
    end note
    
    :Guardar métricas en txt;
    
    :Generar reporte de entrenamiento;
    note right
        • Tiempo total: 4.5 horas
        • Steps totales: 3,750
        • Mejor ROUGE-1: 0.42
        • Loss final: 0.89
    end note
}

:🎉 **Modelo listo para usar**;

stop

legend bottom
    **Tiempos Estimados (RTX 3050):**
    • Descarga dataset: 5-10 min
    • Tokenización: 2-5 min
    • Carga modelo: 1-2 min
    • Entrenamiento: 4-6 horas
    • Evaluación final: 5 min
    
    **Uso de Recursos:**
    • GPU: ~3.5GB VRAM
    • RAM: ~8GB
    • Disco: ~5GB
end legend

@enduml

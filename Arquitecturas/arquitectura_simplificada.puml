@startuml Arquitectura_Sistema_Simplificada
!theme cerulean-outline
skinparam backgroundColor #FFFFFF
skinparam shadowing true
skinparam linetype ortho
skinparam roundcorner 10
skinparam defaultFontSize 13

title **Sistema de Resumen Automático de Videos Educativos**\n**Arquitectura con Transfer Learning y Fine-tuning**

' ==============================================================================
' CAPA DE ENTRADA
' ==============================================================================
package "**📥 ENTRADA**" as entrada #E3F2FD {
    actor "Usuario" as user
    storage "Videos\nEducativos" as videos
}

' ==============================================================================
' CAPA DE TRANSCRIPCIÓN
' ==============================================================================
package "**🎤 TRANSCRIPCIÓN**" as transcripcion #FFF9C4 {
    component "Extractor\nAudio" as extractor
    component "**Whisper**\nPre-entrenado" as whisper
    storage "Transcripciones" as transcripts
}

' ==============================================================================
' CAPA DE ENTRENAMIENTO (UNA VEZ)
' ==============================================================================
package "**🏋️ ENTRENAMIENTO** (Una sola vez)" as entrenamiento #E8F5E9 {
    database "Dataset MLSUM\n(Español)" as dataset
    component "Tokenizador\nmT5" as tokenizer
    component "**mT5-small**\nBase" as mt5_base
    component "Fine-tuning\nTrainer" as trainer
    storage "Modelo\nEntrenado" as modelo_entrenado
}

' ==============================================================================
' CAPA DE INFERENCIA (CADA VIDEO)
' ==============================================================================
package "**🚀 INFERENCIA** (Cada video nuevo)" as inferencia #E1F5FE {
    component "Preprocesador" as preproc
    component "**mT5 Fine-tuned**\nEspecializado" as mt5_finetuned
    component "Post-procesador" as postproc
    storage "Resúmenes" as resumenes
}

' ==============================================================================
' CAPA DE PRESENTACIÓN
' ==============================================================================
package "**📤 SALIDA**" as salida #F3E5F5 {
    component "Interfaz\nWeb" as web
    database "Base de\nDatos" as bd
}

' ==============================================================================
' CAPA DE INFRAESTRUCTURA
' ==============================================================================
package "**🖥️ INFRAESTRUCTURA**" as infra #FFEBEE {
    component "GPU RTX 3050\n4GB VRAM" as gpu
    storage "Almacenamiento\n~5GB" as storage
}

' ==============================================================================
' CAPA DE MONITOREO
' ==============================================================================
package "**📊 MONITOREO**" as monitor #FFF3E0 {
    component "TensorBoard" as tensorboard
    component "Logs" as logs
}

' ==============================================================================
' FLUJO PRINCIPAL
' ==============================================================================

' Entrada → Transcripción
user -right-> videos : "Sube video"
videos -down-> extractor
extractor -down-> whisper : "Audio"
whisper -down-> transcripts : "Texto"

' Entrenamiento (FASE 1 - UNA VEZ)
dataset -down-> tokenizer : "10K ejemplos"
tokenizer -down-> mt5_base : "Tokenizado"
mt5_base -down-> trainer : "Entrenar"
trainer -down-> modelo_entrenado : "4-6 horas"
trainer .left.> tensorboard : "Métricas"
trainer .left.> logs : "Progress"

' Inferencia (FASE 2 - CADA VIDEO)
transcripts -down-> preproc : "Transcripción"
preproc -down-> mt5_finetuned : "Tokenizado"
modelo_entrenado .right.> mt5_finetuned : "Cargar modelo"
mt5_finetuned -down-> postproc : "Resumen"
postproc -down-> resumenes : "5-10 min"

' Salida
resumenes -down-> web : "Mostrar"
web -down-> bd : "Guardar"
web -left-> user : "Visualizar"

' Infraestructura
gpu .up.> trainer : "Acelera"
gpu .up.> mt5_finetuned : "Acelera"
storage .up.> modelo_entrenado : "Guarda"
storage .up.> bd : "Guarda"

' ==============================================================================
' ANOTACIONES
' ==============================================================================
note top of entrenamiento
    **FASE 1: ENTRENAMIENTO**
    • Una sola vez: 4-6 horas
    • Transfer Learning + Fine-tuning
    • Dataset: 10,000 ejemplos
    • Resultado: Modelo especializado
end note

note top of inferencia
    **FASE 2: INFERENCIA**
    • Cada video nuevo: 5-10 min
    • Usa modelo ya entrenado
    • Sin necesidad de dataset
    • Genera resumen automático
end note

note bottom of whisper
    **Pre-entrenado**
    No requiere entrenamiento
end note

note bottom of mt5_finetuned
    **Especializado**
    Entrenado en español
end note

' ==============================================================================
' LEYENDA
' ==============================================================================
legend bottom left
    **Componentes Clave:**
    • 🎤 **Whisper**: Transcripción (pre-entrenado)
    • 🧠 **mT5**: Resumen (requiere fine-tuning)
    • 📊 **Dataset**: MLSUM español (10K ejemplos)
    • 🎮 **GPU**: RTX 3050 (4GB VRAM)
    
    **Dos Fases:**
    1. **Entrenamiento**: Una vez (4-6 hrs)
    2. **Inferencia**: Cada video (5-10 min)
end legend

@enduml

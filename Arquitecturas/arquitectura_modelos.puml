@startuml Arquitectura_Modelos_Transformers
!theme amiga
skinparam backgroundColor #F5F5F5
skinparam roundcorner 15
skinparam shadowing true
skinparam linetype ortho

title **Arquitectura de Modelos Transformer**\n**Whisper (Transcripción) + mT5 (Resumen)**

' ==============================================================================
' WHISPER - MODELO 1
' ==============================================================================
package "🎤 **MODELO 1: WHISPER (OpenAI)**" as whisper_model #E3F2FD {
    
    frame "**Entrada**" as whisper_input #BBDEFB {
        component "🎵 Audio Waveform" as audio_wave
        note bottom
            • Formato: WAV/MP3
            • Sample rate: 16kHz
            • Duration: variable
            • Mono channel
        end note
    }
    
    frame "**Arquitectura Whisper**" as whisper_arch #90CAF9 {
        component "🔊 Audio Encoder" as audio_encoder {
            note right
                **Convolutional Layers**
                • 2 capas 1D conv
                • Kernel: 3, stride: 2
                • Mel-spectrogram features
            end note
        }
        
        component "🧠 Transformer Encoder" as whisper_transformer {
            note right
                **12-24 capas**
                • Multi-head attention
                • Feed-forward networks
                • Positional encoding
                • Layer normalization
            end note
        }
        
        component "📝 Decoder Autoregresivo" as whisper_decoder {
            note right
                **Decodificador**
                • Cross-attention con encoder
                • Genera tokens uno por uno
                • Vocabulario: 50k tokens
            end note
        }
    }
    
    frame "**Salida**" as whisper_output #64B5F6 {
        component "📄 Texto Transcrito" as transcript_text
        note bottom
            • Texto plano
            • Con timestamps
            • Idioma detectado
            • Confianza por palabra
        end note
    }
    
    audio_wave -down-> audio_encoder
    audio_encoder -down-> whisper_transformer
    whisper_transformer -down-> whisper_decoder
    whisper_decoder -down-> transcript_text
}

note right of whisper_model
    **Características:**
    ✓ Pre-entrenado por OpenAI
    ✓ 680,000 horas de audio
    ✓ Multilingüe (99 idiomas)
    ✓ NO requiere fine-tuning
    ✓ Modelo usado: base (74M parámetros)
    ✓ Tiempo: 2-3 min por video 30min
end note

' ==============================================================================
' mT5 - MODELO 2
' ==============================================================================
package "🧠 **MODELO 2: mT5 (Google)**" as mt5_model #E8F5E9 {
    
    frame "**Entrada**" as mt5_input #C8E6C9 {
        component "📝 Texto Largo\n+ Prefijo" as input_text {
            note bottom
                • Input: "resumir: [TEXTO]"
                • Max: 512 tokens
                • Tokenizado con SentencePiece
            end note
        }
    }
    
    frame "**Arquitectura mT5 (Encoder-Decoder)**" as mt5_arch #81C784 {
        
        rectangle "**ENCODER**" as encoder_block #A5D6A7 {
            component "🔤 Token Embedding\n(250k vocab)" as token_emb
            component "📍 Positional Encoding" as pos_enc
            
            together {
                component "🔷 Encoder Layer 1" as enc1 {
                    note right
                        • Self-Attention (12 heads)
                        • Feed-Forward (d_ff=2048)
                        • Layer Norm + Residual
                    end note
                }
                component "🔷 Encoder Layer 2" as enc2
                component "..." as enc_dots
                component "🔷 Encoder Layer 8" as enc8
            }
            
            token_emb -down-> pos_enc
            pos_enc -down-> enc1
            enc1 -down-> enc2
            enc2 -down-> enc_dots
            enc_dots -down-> enc8
        }
        
        rectangle "**DECODER**" as decoder_block #66BB6A {
            component "🔤 Token Embedding" as dec_token_emb
            component "📍 Positional Encoding" as dec_pos_enc
            
            together {
                component "🔶 Decoder Layer 1" as dec1 {
                    note left
                        • Self-Attention (masked)
                        • Cross-Attention con Encoder
                        • Feed-Forward
                        • Layer Norm + Residual
                    end note
                }
                component "🔶 Decoder Layer 2" as dec2
                component "..." as dec_dots
                component "🔶 Decoder Layer 8" as dec8
            }
            
            dec_token_emb -down-> dec_pos_enc
            dec_pos_enc -down-> dec1
            dec1 -down-> dec2
            dec2 -down-> dec_dots
            dec_dots -down-> dec8
        }
        
        enc8 -right-> dec1 : "Cross-Attention"
        enc8 -right-> dec2 : "Cross-Attention"
        enc8 -right-> dec8 : "Cross-Attention"
    }
    
    frame "**Salida**" as mt5_output #4CAF50 {
        component "📄 Resumen Generado" as summary_text {
            note bottom
                • Max: 128 tokens
                • Detokenizado
                • Beam search (k=4)
                • Post-procesado
            end note
        }
    }
    
    input_text -down-> encoder_block
    encoder_block -down-> decoder_block
    decoder_block -down-> summary_text
}

note right of mt5_model
    **Características:**
    ✓ Pre-entrenado por Google (mC4)
    ✓ 101 idiomas
    ✓ 300M parámetros (small)
    ✓ **REQUIERE fine-tuning**
    ✓ Fine-tuned en MLSUM (español)
    ✓ Tiempo inferencia: 1-2 min
end note

' ==============================================================================
' FINE-TUNING PROCESS
' ==============================================================================
package "🏋️ **PROCESO DE FINE-TUNING**" as finetuning #FFF9C4 {
    
    database "📊 Dataset MLSUM\n(10K ejemplos)" as dataset_box #FFF59D {
        component "Ejemplo 1:\nTexto → Resumen" as ex1
        component "Ejemplo 2:\nTexto → Resumen" as ex2
        component "...\n(9998 más)" as ex_more
    }
    
    component "⚙️ Seq2SeqTrainer" as trainer_box #FBC02D {
        note bottom
            **Hiperparámetros:**
            • Learning rate: 3e-5
            • Batch size: 2 (efectivo: 16)
            • Épocas: 3
            • Optimizer: AdamW
            • FP16: True
            • Steps: 3,750
        end note
    }
    
    component "📈 Loss Function" as loss_box #F9A825 {
        note right
            **Cross-Entropy Loss**
            • Compara resumen generado
              vs resumen real
            • Backpropagation
            • Actualiza pesos del modelo
        end note
    }
    
    storage "💾 Modelo Fine-tuned" as finetuned_model #F57F17 {
        note bottom
            • Pesos ajustados
            • Especializado en español
            • Listo para inferencia
        end note
    }
    
    dataset_box -down-> trainer_box : "Alimenta ejemplos"
    trainer_box -down-> loss_box : "Calcula error"
    loss_box -up-> trainer_box : "Ajusta pesos"
    trainer_box -down-> finetuned_model : "Guarda modelo\n(4-6 horas)"
}

' ==============================================================================
' FLUJO COMPLETO
' ==============================================================================
transcript_text -down-> input_text : "Transcripción\n→ Input mT5"

note on link
    **Pipeline Completo:**
    Audio → Whisper → Texto → mT5 → Resumen
end note

finetuned_model .up.> mt5_arch : "Usa pesos\nentrenados"

' ==============================================================================
' COMPARACIÓN DE MODELOS
' ==============================================================================
legend bottom
    |= Característica |= Whisper |= mT5 |
    | **Tarea** | Speech-to-Text | Text-to-Text |
    | **Arquitectura** | Encoder-Decoder | Encoder-Decoder |
    | **Parámetros** | 74M (base) | 300M (small) |
    | **Entrenamiento** | Pre-entrenado (listo) | Pre-entrenado + Fine-tuning |
    | **Idiomas** | 99 | 101 |
    | **Input** | Audio (waveform) | Texto tokenizado |
    | **Output** | Texto transcrito | Texto resumido |
    | **GPU Requerida** | No (puede usar CPU) | Sí (para fine-tuning) |
    | **Tiempo Inferencia** | 2-3 min (30min video) | 1-2 min (texto largo) |
    | **Fine-tuning** | NO necesario | SÍ necesario |
end legend

' ==============================================================================
' TRANSFER LEARNING
' ==============================================================================
note top of mt5_model
    **TRANSFER LEARNING:**
    1. **Pre-training** (Google): mT5 aprende 101 idiomas
    2. **Fine-tuning** (Nosotros): mT5 se especializa en resumir español
    3. **Resultado**: Modelo experto en resumir textos españoles
    
    **Ventaja:** No entrenar desde cero (ahorrar tiempo/recursos)
end note

@enduml

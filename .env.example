# ==============================================
# Resume Videos - Environment Variables
# ==============================================
# Copia este archivo como .env y ajusta los valores según tu configuración

# --- Puertos ---
API_PORT=5000
WEB_PORT=7860

# --- Flask Configuration ---
FLASK_ENV=production
FLASK_DEBUG=0

# --- Model Configuration ---
# Modelo de resumen (HuggingFace o ruta local)
# RECOMENDADO: csebuetnlp/mT5_multilingual_XLSum (modelo entrenado para resumen)
# Otras opciones: google/mt5-small (requiere fine-tuning), google/mt5-base
MODEL_PATH=csebuetnlp/mT5_multilingual_XLSum

# Modelo de Whisper para transcripción
# Opciones: tiny, base, small, medium, large
WHISPER_MODEL=tiny

# --- Paths (dentro del contenedor, no cambiar) ---
DATABASE_PATH=/app/database/resume_videos.db
OUTPUT_DIR=/app/outputs
VIDEO_DIR=/app/videos

# --- HuggingFace Configuration ---
# Token de HuggingFace (opcional, solo si usas modelos privados)
# HF_TOKEN=tu_token_aqui

# Cache de HuggingFace
HF_HOME=/root/.cache/huggingface

# --- Gradio Configuration ---
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860

# --- Logging ---
LOG_LEVEL=INFO
